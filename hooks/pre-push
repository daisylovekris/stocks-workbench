#!/bin/sh
# 同源密钥扫描：待推送提交命中即拒绝 push（fail closed）
# stdin 行格式: <local ref> <local sha> <remote ref> <remote sha>
root="$(cd "$(dirname "$0")/.." && pwd)"
all_zero="0000000000000000000000000000000000000000"

while read -r _local_ref local_sha _remote_ref remote_sha; do
    if [ -z "$local_sha" ]; then
        continue
    fi
    if [ "$remote_sha" = "$all_zero" ]; then
        base="$(git hash-object -t tree /dev/null)"
    else
        base="$remote_sha"
    fi
    python3 "$root/tools/secret_scan.py" --commits "$base..$local_sha" || exit 1
done

exit 0
